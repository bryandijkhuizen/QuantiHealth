<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleDisplayName</key><string>Progressa</string>
<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
<key>CFBundleName</key><string>Progressa</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>NSSupportsLiveActivities</key><true/>
<key>CFBundleShortVersionString</key><string>2.3.1</string><key>CFBundleVersion</key><string>1</string>
<key>CFBundleURLTypes</key><array><dict><key>CFBundleURLName</key><string>progressa</string><key>CFBundleURLSchemes</key><array><string>progressa</string></array></dict></array>
<key>ProgressaSupabaseAnonKey</key><string>$(SUPABASE_ANON_KEY)</string>
<key>ProgressaSupabaseURL</key><string>$(PROGRESSA_SUPABASE_URL)</string>
<key>ProgressaConnectURL</key><string>$(PROGRESSA_CONNECT_URL)</string>
