<key>NSHealthUpdateUsageDescription</key><string>Progressa writes workouts to Apple Health only when you explicitly request it.</string>
<key>NSLocationAlwaysAndWhenInUseUsageDescription</key><string>Progressa may use your location to record an active workout when the app is not visible.</string>
<key>NSLocationWhenInUseUsageDescription</key><string>Progressa uses your location to record and visualise workout routes.</string>
<key>NSPhotoLibraryAddUsageDescription</key><string>Progressa needs permission to save workout exports to your photo library.</string>
<key>NSPhotoLibraryUsageDescription</key><string>Progressa lets you select profile and post images from your photo library.</string>
<key>UIBackgroundModes</key><array><string>remote-notification</string></array>
<key>UILaunchScreen</key><dict/>
<key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
<key>UISupportedInterfaceOrientations~ipad</key><array><string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationPortraitUpsideDown</string><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
