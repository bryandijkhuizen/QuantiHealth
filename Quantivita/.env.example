# Copy this file to .env and fill in your values.
# .env is intentionally ignored by git.

QUANTIVITA_DEVICE_ID=00008150-001E439C2242401C
QUANTIVITA_API_BASE_URL=https://api.quantivita.bryandijkh.com
QUANTIVITA_PUBLIC_BASE_URL=https://api.quantivita.bryandijkh.com
QUANTIVITA_SESSION_SECRET=change-this-to-a-long-random-string
PROGRESSA_API_BASE_URL=https://api.progressa.bryandijkh.com
PROGRESSA_AUTH_BASE_URL=https://api.progressa.bryandijkh.com

QUANTIVITA_HOMESERVER_HOST=192.168.178.20
QUANTIVITA_HOMESERVER_USER=bryan
QUANTIVITA_HOMESERVER_KEY=/Users/bryandijkh/.ssh/codex_homeserver
QUANTIVITA_HOMESERVER_DIR=/home/bryan/stacks/quantivita
QUANTIVITA_API_PORT=8088

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=quantivita://quantivita.app/strava-auth
STRAVA_API_BASE_URL=https://www.strava.com

# iOS/TestFlight build metadata. Increase build number for each upload.
QUANTIVITA_IOS_BUILD_NAME=0.0.1
QUANTIVITA_IOS_BUILD_NUMBER=1
QUANTIVITA_IOS_EXPORT_METHOD=app-store

# Optional: lets build_testflight_ipa.sh check App Store Connect access early.
# Agreements/contracts still must be accepted manually by the account holder.
APP_STORE_CONNECT_API_KEY=
APP_STORE_CONNECT_API_ISSUER=
APP_STORE_CONNECT_API_KEY_PATH=
APP_STORE_CONNECT_PROVIDER_PUBLIC_ID=

# Apple Services ID for web dashboard Sign in with Apple.
# Configure the return URL in Apple Developer as:
#   https://api.quantivita.bryandijkh.com/auth/apple/callback
APPLE_WEB_CLIENT_ID=
