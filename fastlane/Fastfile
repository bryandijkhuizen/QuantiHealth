require "base64"
require "xcodeproj"

default_platform(:ios)

def app_store_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: Base64.decode64(ENV.fetch("APP_STORE_CONNECT_API_KEY_BASE64")),
    is_key_content_base64: false,
    duration: 1200,
    in_house: false
  )
end

def app_path
  File.expand_path(ENV.fetch("APP_PATH"), File.expand_path("..", __dir__))
end

def app_platform
  ENV.fetch("APP_PLATFORM")
end

def app_scheme
  ENV.fetch("IOS_SCHEME")
end

def app_project
  File.join(app_path, "#{app_scheme}.xcodeproj")
end

def app_ipa
  File.join(app_path, "build", "#{app_scheme}.ipa")
end

def app_identifier
  ENV.fetch("IOS_APP_IDENTIFIER")
end

def provisioning_profile_name
  "match AppStore #{app_identifier}"
end

def signing_xcargs
  [
    "CODE_SIGN_STYLE=Manual",
    ("PROVISIONING_PROFILE_SPECIFIER=\"#{provisioning_profile_name}\"" if ENV.fetch("IOS_EXTENSION_IDENTIFIERS", "").empty?),
    "CODE_SIGN_IDENTITY=\"Apple Distribution\"",
    "DEVELOPMENT_TEAM=#{ENV.fetch("IOS_TEAM_ID")}"
  ].compact.join(" ")
end

platform :ios do
  desc "Build and upload the selected Quanti app to TestFlight"
  lane :beta do
    api_key = app_store_api_key

    setup_ci if ENV["CI"]

    identifiers = [app_identifier] + ENV.fetch("IOS_EXTENSION_IDENTIFIERS", "").split(",").reject(&:empty?)
    profiles = identifiers.to_h { |identifier| [identifier, "match AppStore #{identifier}"] }

    if ENV.fetch("QUANTI_MATCH_BOOTSTRAP", "false") == "true"
      identifiers.drop(1).each do |identifier|
        next if Spaceship::ConnectAPI::BundleId.find(identifier)
        Spaceship::ConnectAPI::BundleId.create(
          identifier: identifier, name: "#{app_scheme} Live Activity", platform: "IOS"
        )
      end
    end

    match(
      type: "appstore",
      readonly: ENV.fetch("QUANTI_MATCH_BOOTSTRAP", "false") != "true",
      git_url: ENV.fetch("MATCH_GIT_URL"),
      app_identifier: identifiers,
      api_key: api_key
    )

    Dir.chdir(app_path) do
      if app_platform == "native-ios"
        increment_build_number(
          build_number: ENV.fetch("GITHUB_RUN_NUMBER", Time.now.to_i.to_s),
          xcodeproj: app_project
        )
        if identifiers.length > 1
          project = Xcodeproj::Project.open(app_project)
          project.targets.each do |target|
            target.build_configurations.each do |configuration|
              identifier = configuration.build_settings["PRODUCT_BUNDLE_IDENTIFIER"]
              next unless profiles.key?(identifier)
              configuration.build_settings["PROVISIONING_PROFILE_SPECIFIER"] = profiles.fetch(identifier)
            end
          end
          project.save
        end
        build_app(
          project: app_project,
          scheme: app_scheme,
          export_method: "app-store",
          clean: true,
          output_directory: File.join(app_path, "build"),
          output_name: "#{app_scheme}.ipa",
          xcargs: signing_xcargs,
          export_options: {
            provisioningProfiles: profiles
          }
        )
        upload_to_testflight(
          api_key: api_key,
          ipa: app_ipa,
          skip_waiting_for_build_processing: true
        )
      else
        UI.user_error!("Unsupported APP_PLATFORM: #{app_platform}")
      end
    end
  end
end
