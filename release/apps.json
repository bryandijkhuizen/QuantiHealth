{
  "apps": [
    {
      "id": "quantivita",
      "name": "Quantivita",
      "path": "Quantivita",
      "platform": "flutter-ios",
      "scheme": "Runner",
      "tagPrefix": "quantivita-ios-v",
      "bundleIdentifierSecret": "QUANTIVITA_IOS_APP_IDENTIFIER",
      "testCommand": "flutter analyze && flutter test"
    },
    {
      "id": "quantivita-native",
      "name": "Quantivita Native",
      "path": "QuantivitaNative",
      "platform": "native-ios",
      "scheme": "QuantivitaNative",
      "tagPrefix": "quantivita-native-ios-v",
      "bundleIdentifierSecret": "QUANTIVITA_NATIVE_IOS_APP_IDENTIFIER",
      "testCommand": "xcodebuild test -project QuantivitaNative.xcodeproj -scheme QuantivitaNative -destination 'platform=iOS Simulator,name=iPhone 16'"
    },
    {
      "id": "progressa-native",
      "name": "Progressa Native",
      "path": "ProgressaNative",
      "platform": "native-ios",
      "scheme": "ProgressaNative",
      "tagPrefix": "progressa-native-ios-v",
      "bundleIdentifierSecret": "PROGRESSA_NATIVE_IOS_APP_IDENTIFIER",
      "testCommand": "xcodebuild test -project ProgressaNative.xcodeproj -scheme ProgressaNative -destination 'platform=iOS Simulator,name=iPhone 16'"
    }
  ]
}
